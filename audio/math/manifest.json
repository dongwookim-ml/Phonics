      "rmsDb": -16.38,
      "sha256": "72592a38baf7906bacb508605da3ae40d98cc7124d196b205264acee5b53ad5d"
    },
    {
      "voice": "am_liam",
      "text": "Find the square.",
      "speed": 0.9,
      "file": "audio/math/f4816df69b504266c8b4.m4a",

      "rmsDb": -16.49,
      "sha256": "c2422bccfdd838ba07fe4f0ebb7667e5dd6f96cfeb930e89d2470b05d52456be"
    },
    {
      "voice": "am_liam",
      "text": "Find the oval.",
      "speed": 0.9,
      "file": "audio/math/6170bd2f3b375cf05c67.m4a",

      "rmsDb": -16.01,
      "sha256": "9836102998f2198322294bfa32e46ac36007280d168137a4613a7644d8090ce8"
    },
    {
      "voice": "am_liam",
      "text": "Find the star.",
      "speed": 0.9,
      "file": "audio/math/4064a354c45f0e1ae8f3.m4a",
      "seconds": 1.212,
      "rmsDb": -16.66,
      "sha256": "7e762e06a4e163a2715496bc175a435f4d389ac86db2e66a0b239376337c33f4"
    },
    {
      "voice": "am_liam",
      "text": "Look at curved lines, straight sides and corners.",
      "speed": 0.9,
      "file": "audio/math/14daa1d13d27ae12e485.m4a",
      "seconds": 3.288,
      "rmsDb": -17.09,
      "sha256": "3d12f42e428d8cdf942fd5b3b1febb65cdf0e40fe68a61be3885da2bbea53e54"
    },
    {
      "voice": "am_liam",
      "text": "Find the same shape. Its color may be different.",
      "speed": 0.9,
      "file": "audio/math/cf14853c0c654c3b29b3.m4a",
      "seconds": 3.655,
      "rmsDb": -18.41,
      "sha256": "7051cd0a829588c1184edb37aecc805296b441231b9c1ba631529c8c374253c7"
    },
    {
      "voice": "am_liam",
      "text": "Focus on the outline. Turning it or changing its color does not change the shape.",
      "speed": 0.9,
      "file": "audio/math/5acac3d20fdbb9976197.m4a",
      "seconds": 5.38,
      "rmsDb": -16.98,
      "sha256": "be60dac5a69ff53f3699fa639a6d6788f5fb72c0fff57c998e36c3c46599cb75"
    },
    {
      "voice": "am_liam",
      "text": "How many straight sides does this shape have?",
      "speed": 0.9,
      "file": "audio/math/95ec30760f8778ef55ce.m4a",
      "seconds": 2.65,
      "rmsDb": -17.11,
      "sha256": "789f1a7608c62aebf753b140c834bf4d98f49176ac4c1a2f2f7c8273d526ac73"
    },
    {
      "voice": "am_liam",
      "text": "Follow the outline and count each straight side once.",
      "speed": 0.9,
      "file": "audio/math/b0d496d3d5c9dcdc56e0.m4a",
      "seconds": 3.337,
      "rmsDb": -17.35,
      "sha256": "7548657304ac7b09966e334a665a91f553c0b2cba567132c45eb5a7918468f65"
    },
    {
      "voice": "am_liam",
      "text": "Look at the repeating shapes. What comes next?",
      "speed": 0.9,
      "file": "audio/math/ed7f3d82d45330f7768c.m4a",
      "seconds": 3.467,
      "rmsDb": -16.97,
      "sha256": "478f43943bd819734dd395bb7806d69478e102113017dede4e9ae51281025ff6"
    },
    {
      "voice": "am_liam",
      "text": "Find the small group that repeats.",

    {
      "voice": "am_adam",
      "text": "Welcome to my bakery! Let\u2019s count some cookies.",
      "speed": 0.95,
      "file": "audio/math/b895f17e02e4bb11507b.m4a",
      "seconds": 2.842,
      "rmsDb": -18.37,
      "sha256": "908e1f199ff2e2ee48f2dd495f5a00b6ff43b9dd11f026a8d326eb83acf64b03"
    },
    {
      "voice": "am_adam",
      "text": "How many cookies are on the tray?",
      "speed": 0.9,
      "file": "audio/math/840981f8414e99ecaf55.m4a",
      "seconds": 1.55,
      "rmsDb": -17.77,
      "sha256": "50fc3eeab720046d2d94ee3cf5013ad9781e60abc947d2ffb0cde65099e1d024"
    },
    {
      "voice": "am_adam",
      "text": "Each full tray holds 10 cookies. Count the full trays, then the extra cookies.",
      "speed": 0.9,
      "file": "audio/math/c040839f8b3801756d8d.m4a",
      "seconds": 4.768,
      "rmsDb": -19.03,
      "sha256": "b68f1e25a16da81a85c62c6012b8fad61d64005cd04ce9dcfc9ec42dbbf893ba"
    },
    {
      "voice": "am_adam",
      "text": "Count the cookies for this order.",
      "speed": 0.9,
      "file": "audio/math/a1beb52c080851841c85.m4a",
      "seconds": 1.438,
      "rmsDb": -19.0,
      "sha256": "94e3434bc0641bdae700f284ab2c18b6c6fa0fc3e2c0b54949a19f164c2665e9"
    },
    {
      "voice": "am_adam",
      "text": "Count the cookie trays, then the extra cookies.",
      "speed": 0.9,
      "file": "audio/math/adaca30e72609bfa7ed2.m4a",
      "seconds": 2.487,
      "rmsDb": -19.27,
      "sha256": "b0c938cb147a255897379ccbb4120ade6a594a6d8cec90c25c6c702feede1572"
    },
    {
      "voice": "af_bella",
      "text": "Welcome! Let\u2019s make some yummy ice cream.",
      "speed": 0.95,
      "file": "audio/math/e34c9ad13cd3ffcf7cb0.m4a",
      "seconds": 3.308,
      "rmsDb": -17.33,
      "sha256": "cbe89029be0cb32414e550b9cebe01efb2a9692591d7ac069366a930be294b70"
    },
    {
      "voice": "af_bella",
      "text": "Add the ice cream scoops. How many altogether?",
      "speed": 0.9,
      "file": "audio/math/1587e2acafb6b71b4de1.m4a",
      "seconds": 3.571,
      "rmsDb": -17.49,
      "sha256": "22ff521f3c22b4c3ca2e5e40f7b833dcb8f2b974e8c092bea1a7398d343b46c4"
    },
    {
      "voice": "af_bella",
      "text": "Start with the first group and count on through the other group.",
      "speed": 0.9,
      "file": "audio/math/784ff9fe799adb4a57c8.m4a",
      "seconds": 3.219,
      "rmsDb": -17.3,
      "sha256": "b50b711a149391bfab3064a1f8d4c66041ebfcbc741408a1b51f32451973b5f2"
    },
    {
      "voice": "af_bella",
      "text": "The crossed-out scoops were served. How many are left?",
      "speed": 0.9,
      "file": "audio/math/3905b195d10a52daed2c.m4a",
      "seconds": 3.66,
      "rmsDb": -17.82,
      "sha256": "8b82c86e674e481e8e2a68edbfd049db07146859419066c78638f74b40371525"
    },
    {
      "voice": "af_bella",
      "text": "The crossed-out scoops are gone. Count only the scoops left.",
      "speed": 0.9,
      "file": "audio/math/4fe6df0f5fe3d736dbfd.m4a",
      "seconds": 4.108,
      "rmsDb": -17.87,
      "sha256": "9d0f7830a9c79c49cf081313d52cf8b620a31e807b1c24d97becd2176d4c25ec"
    },
    {
      "voice": "am_liam",
      "text": "Hello! Let\u2019s build and play with shapes.",
      "speed": 0.95,
      "file": "audio/math/99c238c7cd5bb522783a.m4a",
      "seconds": 3.305,
      "rmsDb": -18.01,
      "sha256": "8d16b21d3b2413a8982a9edd39922eb97aa133b49d399786e0693c5c102c71d2"
    },
    {
      "voice": "am_liam",
      "text": "Find the circle.",
      "speed": 0.9,
      "file": "audio/math/597352b245b152316bab.m4a",
      "seconds": 1.188,
      "rmsDb": -16.86,
      "sha256": "6bf5c42e822ac19ce5c0914a0f130c8eb473165c0a53610e6b2a52c4179bba0c"
    },
    {
      "voice": "am_liam",
      "text": "Find the triangle.",
      "speed": 0.9,
